APP_NAME="Prop Firm"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Production (DigitalOcean droplet) uses MySQL 8. Local dev may use sqlite by
# setting DB_CONNECTION=sqlite and creating database/database.sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=propfirm
DB_USERNAME=propfirm
DB_PASSWORD=

# --- Session / Cache / Queue ---------------------------------------------
# Redis is the production cache & queue backend.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=propfirm

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- File storage ---------------------------------------------------------
# KYC docs, certificates and reward videos MUST go to S3-compatible object
# storage (DO Spaces / Cloudflare R2 / S3) — never local disk.
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail -----------------------------------------------------------------
# Use SMTP/SES (Hostinger Business Email / Google Workspace / SES).
# Do NOT run a mail server on the droplet.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Crypto payment gateway ----------------------------------------------
# Pick one: nowpayments | coinpayments | cryptomus. Fill the matching keys.
PAYMENT_GATEWAY=nowpayments

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

COINPAYMENTS_PUBLIC_KEY=
COINPAYMENTS_PRIVATE_KEY=
COINPAYMENTS_IPN_SECRET=

CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# --- MT5 automation (Module D, Option 2 — later) -------------------------
METAAPI_TOKEN=
METAAPI_REGION=new-york

VITE_APP_NAME="${APP_NAME}"
