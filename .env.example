APP_NAME="Prop Firm"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# First admin account (created by the seeder). CHANGE THESE before seeding
# in production, or change the password right after first login.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Production (DigitalOcean droplet) uses MySQL 8. Local dev may use sqlite by
# setting DB_CONNECTION=sqlite and creating database/database.sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=propfirm
DB_USERNAME=propfirm
DB_PASSWORD=

# --- Session / Cache / Queue ---------------------------------------------
# Redis is the production cache & queue backend.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=propfirm

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- File storage ---------------------------------------------------------
# KYC docs, certificates and reward videos MUST go to S3-compatible object
# storage (DO Spaces / Cloudflare R2 / S3) — never local disk.
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail -----------------------------------------------------------------
# Do NOT run a mail server on the droplet.
#
# Quick start with NO domain: Gmail SMTP + an App Password (needs 2-Step
# Verification on the Google account, then create one at
# https://myaccount.google.com/apppasswords). Values:
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_USERNAME=<your@gmail.com>
#   MAIL_PASSWORD=<16-char app password, no spaces>
#   MAIL_FROM_ADDRESS=<your@gmail.com>
# For production later, move to a domain sender (SES / Brevo / Mailgun).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Crypto payment gateway ----------------------------------------------
# PAYMENT_GATEWAY selects the active driver:
#   manual      → no external service; order is pending, admin confirms payment
#   nowpayments → hosted crypto checkout + IPN webhook (needs the keys below)
# Start on "manual" until a gateway account exists.
PAYMENT_GATEWAY=manual

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# Manual gateway — wallet addresses the trader sends crypto to (per method).
WALLET_USDT_BSC=
WALLET_USDT_TRC20=
WALLET_USDT_ERC20=
WALLET_USDT_SOL=
WALLET_BTC=
WALLET_USDC_ETH=

# --- MT5 automation (Module D, Option 2 — later) -------------------------
METAAPI_TOKEN=
METAAPI_REGION=new-york

VITE_APP_NAME="${APP_NAME}"
